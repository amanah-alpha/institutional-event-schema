{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amanah-alpha.github.io/institutional-event-schema/schema/position.schema.json",
  "title": "Position Payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["asset", "quantity", "portfolio_weight", "instrument_type"],
  "properties": {
    "asset": { "$ref": "#/$defs/asset" },
    "quantity": { "$ref": "#/$defs/signed_decimal" },
    "portfolio_weight": { "$ref": "#/$defs/unit_decimal" },
    "instrument_type": { "enum": ["SPOT", "MARGIN", "PERPETUAL", "OTHER"] },
    "fill_refs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 128 },
      "uniqueItems": true,
      "description": "Known source fill identifiers supporting the position; omission is permitted when linkage is unavailable."
    }
  },
  "$defs": {
    "asset": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9._-]{1,31}$" },
    "signed_decimal": { "type": "string", "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$" },
    "unit_decimal": { "type": "string", "pattern": "^(?:0(?:\\.[0-9]+)?|1(?:\\.0+)?)$" }
  }
}
