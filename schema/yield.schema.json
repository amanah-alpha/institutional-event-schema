{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amanah-alpha.github.io/institutional-event-schema/schema/yield.schema.json",
  "title": "Yield Payload",
  "description": "Describes a source-reported yield activity without encoding Sharia acceptability.",
  "type": "object",
  "additionalProperties": false,
  "required": ["product_ref", "asset", "quantity", "classification"],
  "properties": {
    "product_ref": { "type": "string", "minLength": 1, "maxLength": 128 },
    "asset": { "$ref": "#/$defs/asset" },
    "quantity": { "$ref": "#/$defs/nonnegative_decimal" },
    "classification": { "enum": ["LENDING", "STAKING", "OTHER", "UNKNOWN"] }
  },
  "$defs": {
    "asset": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9._-]{1,31}$" },
    "nonnegative_decimal": { "type": "string", "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$" }
  }
}
